{
    "name": "laveroadmin/seo",
    "description": "SEO redirects manager (301/302/410), robots.txt editor, and global meta settings for LaveroAdmin.",
    "type": "library",
    "keywords": ["lavero-admin", "laveroadmin", "seo", "redirects", "robots"],
    "license": "MIT",
    "authors": [
        {
            "name": "Aleksandr Kireev",
            "email": "hello@bespredel.name"
        }
    ],
    "require": {
        "php": ">=8.1",
        "laveroadmin/laveroadmin": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "LaveroAdmin\\Admin\\Seo\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaveroAdmin\\Admin\\Seo\\SeoServiceProvider"
            ]
        }
    }
}
